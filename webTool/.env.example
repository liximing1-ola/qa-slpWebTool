# 云服务器部署环境变量配置
# 部署前请根据实际情况修改以下配置

# ===== Flask 应用配置 =====
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=2023

# ===== 数据库配置 =====
DB_HOST=192.168.1.24
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=xianshi

# ===== 数据库连接池配置 =====
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ===== API 配置 =====
API_BASE_URL=https://127.0.0.1
