# 云服务器部署环境变量配置
# 部署前请根据实际情况修改以下配置

# ===== Flask 应用配置 =====
FLASK_ENV=production
FLASK_DEBUG=False
# 下面两个只对 `python app.py` 本地调试生效；线上由 systemd unit 的 `-b 0.0.0.0:9090` 决定
FLASK_HOST=127.0.0.1
FLASK_PORT=2023

# ===== 数据库配置 =====
DB_HOST=192.168.1.24
DB_PORT=3306
# 数据库账号：建议使用只对用到的库表有 DML 权限的账号，不要用 root
DB_USER=root
DB_PASSWORD=root
DB_NAME=xianshi

# ===== 数据库连接池配置 =====
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
# 建立连接的超时时间（秒）：数据库不可达时快速失败，不把 worker 卡住
DB_CONNECT_TIMEOUT=5
# 连接池耗尽的等待时间（秒）
DB_POOL_TIMEOUT=10

# ===== 请求限制 =====
# 请求体大小上限（字节），默认 2MB
MAX_CONTENT_LENGTH=2097152

# ===== 操作审计 =====
# 审计日志目录，留空则用 webTool/logs，按天生成 audit-YYYYMMDD.jsonl
# 想写到系统日志目录时改成 /var/log/web2026（需保证运行用户有写权限）
AUDIT_LOG_DIR=
# 操作记录查询页（/web2026/sqlDemo）的访问密码：留空则该页面关闭（403）
# 修改后需 systemctl restart web2026 才生效
AUDIT_VIEW_PASSWORD=
# 该页面一次展示的记录条数
AUDIT_VIEW_RECENT=10

# ===== API 配置 =====
# 创建商业房间的 RPC 地址
ROOM_CREATE_URL=http://127.0.0.1/rpc/Room.Busi/CreateBusiness

# ===== 安全配置 =====
# /api/sql 访问口令，留空则该接口关闭（推荐留空）
SQL_API_TOKEN=
# 平台基础认证，两项都填写才启用，留空则不启用（保持现有访问方式）
# 启用后浏览器会弹框要求输入用户名密码
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
